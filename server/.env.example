PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/gdgoc
JWT_SECRET=change_me_to_a_long_random_string
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Campus Email Policy
ALLOWED_EMAIL_DOMAINS=psit.ac.in

# OTP HMAC Key (defaults to JWT_SECRET if not explicitly set)
OTP_SECRET=change_me_to_a_long_random_hmac_secret

# Transactional Email Delivery (Resend API)
RESEND_API_KEY=re_placeholder_api_key
EMAIL_FROM=GDGoC PSIT <noreply@psit.ac.in>

# Persistent Cloud Storage for Event Posters (Production)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Superadmin Bootstrap Credentials
SUPERADMIN_EMAIL=admin@psit.ac.in
SUPERADMIN_PASSWORD=change_me_to_a_secure_password
SUPERADMIN_NAME=GDGoC Lead Admin

# Administrative Safeguards
FORCE_ADMIN_PASSWORD_RESET=false
